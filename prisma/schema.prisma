// OffCampus — schema (SQLite/Postgres compatible via provider swap).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  username     String  @unique
  passwordHash String
  name         String
  branch       String?
  year         Int?
  bio          String?
  avatarUrl    String?
  storyReactions StoryReaction[]
  collegeId String?
  college   College? @relation(fields: [collegeId], references: [id])

  posts        Post[]
  comments     Comment[]
  postVotes    PostVote[]
  commentVotes CommentVote[]
  memberships  Membership[]
  following    Follow[]      @relation("follower")
  followers    Follow[]      @relation("following")
  stories      Story[]       @relation("authorStories")
  notifications      Notification[] @relation("recipient")
  actedNotifications Notification[] @relation("actor")
  Conversational1    Conversation[] @relation("conv1")
  Conversational2    Conversation[] @relation("conv2")
  messages           Message[]        @relation("sender")
  notifyFollow       Boolean        @default(true)
  notifyComment      Boolean        @default(true)
  notifyReply        Boolean        @default(true)
  notifyVote         Boolean        @default(true)
  isPrivate          Boolean        @default(false)
  notifyMessage      Boolean        @default(true)
  createdAt DateTime @default(now())

  @@index([collegeId])
}

model College {
  id   String  @id @default(cuid())
  code String  @unique
  name String
  city String?

  users       User[]
  communities Community[]
}

model Community {
  id          String  @id @default(cuid())
  collegeId   String
  college     College @relation(fields: [collegeId], references: [id])
  type        String
  name        String
  slug        String  @unique
  description String?

  posts   Post[]
  members Membership[]

  createdAt DateTime @default(now())

  @@index([collegeId])
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  communityId String
  community   Community @relation(fields: [communityId], references: [id])
  role        String    @default("MEMBER")

  createdAt DateTime @default(now())

  @@unique([userId, communityId])
  @@index([communityId])
}

model Post {
  id          String    @id @default(cuid())
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  communityId String
  community   Community @relation(fields: [communityId], references: [id])

  type    String  @default("TEXT")
  title   String
  body    String?
  linkUrl String?

  score Int @default(0)

  comments Comment[]
  votes    PostVote[]
  tags     PostTag[]

  createdAt DateTime @default(now())

  @@index([communityId])
  @@index([authorId])
}

model Comment {
  id       String    @id @default(cuid())
  postId   String
  post     Post      @relation(fields: [postId], references: [id])
  authorId String
  author   User      @relation(fields: [authorId], references: [id])
  parentId String?
  parent   Comment?  @relation("replies", fields: [parentId], references: [id])
  replies  Comment[] @relation("replies")
  body     String
  score    Int       @default(0)

  votes CommentVote[]

  createdAt DateTime @default(now())

  @@index([postId])
  @@index([parentId])
}

model PostVote {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  postId String
  post   Post   @relation(fields: [postId], references: [id])
  value  Int

  @@unique([userId, postId])
  @@index([postId])
}

model CommentVote {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id])
  value     Int

  @@unique([userId, commentId])
  @@index([commentId])
}

model PostTag {
  postId String
  post   Post   @relation(fields: [postId], references: [id])
  tag    String

  @@id([postId, tag])
  @@index([tag])
}

model Follow {
  id          String @id @default(cuid())
  followerId  String
  follower    User   @relation("follower", fields: [followerId], references: [id])
  followingId String
  following   User   @relation("following", fields: [followingId], references: [id])
  status      String @default("ACCEPTED")
  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("recipient", fields: [userId], references: [id])
  actorId   String
  actor     User     @relation("actor", fields: [actorId], references: [id])
  type      String
  postId    String?
  commentId String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model Conversation {
  id        String    @id @default(cuid())
  user1Id   String
  user1     User      @relation("conv1", fields: [user1Id], references: [id])
  user2Id   String
  user2     User      @relation("conv2", fields: [user2Id], references: [id])
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation("sender", fields: [senderId], references: [id])
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  storyMediaUrl  String?
    storyMediaType  String?
  @@index([conversationId, createdAt])
}
model Story {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation("authorStories", fields: [authorId], references: [id], onDelete: Cascade)
  mediaUrl  String
  type      String   @default("IMAGE")
  createdAt DateTime @default(now())
  expiresAt DateTime
  reactions StoryReaction[]
  @@index([authorId])
  @@index([expiresAt])
}
model StoryReaction {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
  @@index([storyId])
}